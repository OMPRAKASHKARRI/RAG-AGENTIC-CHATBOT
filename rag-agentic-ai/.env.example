# Groq: used ONLY for LLM answer generation (openai/gpt-oss-20b)
GROQ_API_KEY=
# Pinecone: vector database AND hosted embeddings (llama-text-embed-v2, 1024 dimensions)
PINECONE_API_KEY=
# Use a NEW name; indexes created for earlier versions (1536 or 384 dimensions) are incompatible
PINECONE_INDEX_NAME=agentic-ai-index-api
